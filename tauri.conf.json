{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileDock",
  "version": "1.2.0",
  "identifier": "com.filedock.desktop",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "本地文件编辑器与对比工具",
    "longDescription": "FileDock：多标签编辑器、文件与文件夹对比、Everything 式快速查找，全部在本机运行。",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
